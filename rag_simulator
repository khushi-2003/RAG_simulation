<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>RAG Simulator</title>

<style>

body{
font-family:Arial, sans-serif;
background:#0f172a;
color:white;
margin:0;
padding:30px;
}

h1{
text-align:center;
}

.container{
max-width:900px;
margin:auto;
}

.card{
background:#1e293b;
padding:20px;
margin-bottom:20px;
border-radius:10px;
box-shadow:0 0 10px rgba(0,0,0,0.3);
}

textarea,input{
width:100%;
padding:10px;
margin-top:10px;
border-radius:6px;
border:none;
}

button{
margin-top:10px;
padding:10px 15px;
border:none;
background:#38bdf8;
color:black;
font-weight:bold;
border-radius:6px;
cursor:pointer;
}

button:hover{
background:#0ea5e9;
}

.step{
margin-top:10px;
background:#334155;
padding:10px;
border-radius:6px;
}

.chunk{
background:#475569;
padding:8px;
margin:5px 0;
border-radius:5px;
}

.result{
background:#22c55e;
padding:10px;
border-radius:6px;
margin-top:10px;
color:black;
}

</style>
</head>


<body>

<h1>RAG Simulator</h1>

<div class="container">

<div class="card">
<h3>1. Enter Document</h3>
<textarea id="document" rows="4" placeholder="Paste document text..."></textarea>
<button onclick="chunkDocument()">Create Chunks</button>

<div id="chunks"></div>
</div>


<div class="card">
<h3>2. Generate Embeddings</h3>
<button onclick="createEmbeddings()">Generate Embeddings</button>
<div id="embeddings"></div>
</div>


<div class="card">
<h3>3. Ask a Question</h3>
<input id="query" placeholder="Enter your query"/>
<button onclick="search()">Run RAG</button>

<div id="similarity"></div>

<div id="answer"></div>

</div>

</div>


<script>

let chunks=[]
let vectors=[]


function chunkDocument(){

let text=document.getElementById("document").value

chunks=text.split(".").filter(x=>x.trim()!="")

let html=""

chunks.forEach((c,i)=>{
html+=`<div class="chunk">Chunk ${i+1}: ${c}</div>`
})

document.getElementById("chunks").innerHTML=html

}



function fakeEmbedding(text){

let vec=[]

for(let i=0;i<5;i++){

vec.push(Math.random())

}

return vec

}



function createEmbeddings(){

vectors=chunks.map(c=>fakeEmbedding(c))

let html=""

vectors.forEach((v,i)=>{

html+=`<div class="step">
Chunk ${i+1} Vector: ${JSON.stringify(v)}
</div>`

})

document.getElementById("embeddings").innerHTML=html

}



function cosine(a,b){

let dot=0
let magA=0
let magB=0

for(let i=0;i<a.length;i++){

dot+=a[i]*b[i]
magA+=a[i]*a[i]
magB+=b[i]*b[i]

}

magA=Math.sqrt(magA)
magB=Math.sqrt(magB)

return dot/(magA*magB)

}



function search(){

let query=document.getElementById("query").value

let queryVec=fakeEmbedding(query)

let scores=vectors.map(v=>cosine(v,queryVec))

let bestIndex=scores.indexOf(Math.max(...scores))

let simHTML=""

scores.forEach((s,i)=>{

simHTML+=`<div class="step">
Similarity with Chunk ${i+1}: ${s.toFixed(3)}
</div>`

})

document.getElementById("similarity").innerHTML=simHTML


let response=chunks[bestIndex]

document.getElementById("answer").innerHTML=
`<div class="result">
Top Chunk Retrieved:<br><br>
${response}
</div>`

}

</script>


</body>
</html>
